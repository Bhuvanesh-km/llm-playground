generator client {
  // v7's generator. The old `prisma-client-js` is legacy and generates into
  // node_modules, which breaks on a pnpm store; this one emits real source we
  // control the location of.
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  // No `url` here: Prisma 7 requires the connection URL to live in
  // prisma.config.ts for the CLI, and to reach the client through a driver
  // adapter. See lib/prisma.ts.
  provider = "postgresql"
}

/// A person, identified by Clerk. Nothing writes this table yet: Clerk is
/// deliberately deferred until after the design feature, so `clerkUserId` has
/// no producer until then. It exists now because every other table needs
/// somewhere to point.
model User {
  id          String   @id @default(uuid())
  /// Clerk's own user id. The only link between this row and an actual
  /// signed-in person, so it is unique and required rather than nullable.
  clerkUserId String   @unique
  createdAt   DateTime @default(now())

  threads Thread[]
  votes   Vote[]
}

/// One conversation. Readable by anyone holding the link, which is what makes a
/// thread shareable; only the owner can add a turn or vote. There is
/// deliberately no visibility flag, because nothing in the scope asks for
/// private threads and inventing one now would be scope nobody requested.
model Thread {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  turns Turn[]

  @@index([ownerId, updatedAt])
}

/// One prompt, sent to one to three models at once.
///
/// This is a table rather than a flat list of messages because it is the unit
/// three separate things actually hinge on: a vote belongs to a turn, the "two
/// or more models answered" rule is a property of a turn, and the per-thread
/// win record counts votable turns. Replaying a single model's own conversation
/// is still simple: every turn's prompt, plus that model's own answers, in
/// `index` order.
model Turn {
  id       String @id @default(uuid())
  threadId String
  prompt   String
  /// Position within the thread, starting at 0. Ordering by `createdAt` would
  /// be a guess; this is the real sequence, and the unique constraint stops two
  /// turns ever claiming the same slot.
  index    Int

  createdAt DateTime @default(now())

  thread  Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  answers Answer[]
  vote    Vote?

  @@unique([threadId, index])
}

/// What one model did with one turn's prompt.
///
/// A failure is a recorded fact here, not an absent row: the arena has to show
/// which model failed, and the leaderboard has to know that a failed answer was
/// never a real chance to win.
enum AnswerStatus {
  /// Still arriving. A row can sit here if the connection drops mid-stream.
  STREAMING
  /// Finished normally, with a finish reason from the provider.
  COMPLETE
  /// The provider failed. `errorMessage` holds the plain human sentence that
  /// was shown; the raw provider error stays in the server logs.
  FAILED
  /// Cancelled before it finished, by the reader or the person.
  ABORTED
}

/// Why an answer failed, in a form code can act on.
///
/// The human sentence in `errorMessage` is for a person; this is for the app.
/// Without it the only record of a failure was prose, and prose is not
/// something the model picker can filter on.
enum AnswerFailureKind {
  /// The provider will not serve this model to this app, and retrying does not
  /// help. OpenRouter gates some free models to agentic harnesses only, and two
  /// of those have the largest context windows in the catalogue, so ranking
  /// defaults by context alone put permanently dead models in front of every
  /// new person.
  PERMANENT_REFUSAL
  /// Busy, out of capacity, timed out, cancelled. Worth trying again.
  TRANSIENT
}

model Answer {
  id     String @id @default(uuid())
  turnId String

  /// OpenRouter's model id, for example `minimax/minimax-m3:free`.
  modelId   String
  /// The display name as it was at the time of the call. Denormalised on
  /// purpose: the free-tier catalogue is live and models disappear from it, so
  /// a leaderboard row for a retired model must still be able to name itself
  /// without asking OpenRouter about a model it no longer lists.
  modelName String

  status       AnswerStatus @default(STREAMING)
  content      String       @default("")
  /// The plain sentence shown to the person when `status` is FAILED. Never a
  /// stack trace, never raw provider text.
  errorMessage String?
  /// Set only when `status` is FAILED. Deliberately not derived from
  /// `errorMessage`: matching on a sentence written for a person is exactly the
  /// kind of thing that breaks the next time the wording improves.
  failureKind  AnswerFailureKind?
  finishReason String?

  /// Measured on the server the moment the first content delta arrived, so it
  /// times the model rather than the browser. Null if nothing ever arrived.
  ttftMs          Int?
  elapsedMs       Int?
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  /// Output tokens divided by generating time, so it excludes the wait for the
  /// first token, which is already reported on its own as `ttftMs`.
  tokensPerSecond Float?
  /// OpenRouter's own reported cost. Every model here is free tier, so this is
  /// a real measured 0 rather than a placeholder. Decimal rather than Float
  /// because it is money and a float would quietly stop being honest.
  costUsd         Decimal? @db.Decimal(12, 8)

  createdAt DateTime @default(now())

  turn Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)
  wins Vote[]

  /// A model answers a given turn once.
  @@unique([turnId, modelId])
  /// Every leaderboard number groups by model and filters on status.
  @@index([modelId, status])
  /// Reading each model's most recent outcome, to keep models that will never
  /// answer out of the default selection.
  @@index([modelId, createdAt])
}

/// One turn's winner.
///
/// `turnId` is unique, so a turn has at most one vote. That is the real
/// database guarantee. The rule that a vote may only exist where two or more
/// models actually answered is NOT enforced here: Postgres cannot express
/// "this row may exist only if two sibling rows completed" without a trigger.
/// It is application logic, and it is written down as such rather than implied.
model Vote {
  id       String @id @default(uuid())
  turnId   String @unique
  answerId String
  voterId  String

  createdAt DateTime @default(now())

  turn   Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)
  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  voter  User   @relation(fields: [voterId], references: [id], onDelete: Cascade)

  /// The personal leaderboard is every vote by one person.
  @@index([voterId])
  @@index([answerId])
}
