# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_api_key
CLERK_SECRET_KEY=your_api_key

# Get a key at https://console.arcjet.com
ARCJET_KEY=your_api_key

# Postgres connection string. Prisma reads it through the driver adapter in lib/prisma.ts.
DATABASE_URL=

# Project settings -> Project API key, at https://us.posthog.com
# The token is read by both the browser and the server. The host is read only by
# the server: the browser posts to this app's own /ingest rewrite instead.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
